<UserControl x:Class="WpfApp.Components.KeyboardView.KeyboardPerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:kbview="clr-namespace:WpfApp.Components.KeyboardView"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1320"
             Background="{DynamicResource DdBgBase}"
             Focusable="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Canvas column -->
        <Grid Grid.Column="0" Margin="16,16,12,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SegmentedTabStyle hoisted to Themes/CustomStyles.xaml (shared
                 with the top-level Keyboard / Lighting nav strip). -->

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="PER-KEY ACTUATION"
                               FontFamily="{DynamicResource DdFontSans}"
                               FontSize="10"
                               FontWeight="Medium"
                               Foreground="{DynamicResource DdFg3}"
                               Margin="0,0,0,4"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- TextTrimming + ToolTip so the title ellipsizes
                         instead of clipping behind the action buttons
                         when the window is narrow; hover reveals the
                         full text. ToolTip binds to .Text so it always
                         matches whatever RefreshHeaderAndBanner set. -->
                    <TextBlock x:Name="HeaderTitle"
                               Text="DrunkDeer A75 Pro · click any key to edit"
                               FontFamily="{DynamicResource DdFontSans}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DdFg1}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                </StackPanel>
                <Button x:Name="DownloadsButton" Grid.Column="1"
                        Content="Manual &amp; firmware"
                        ToolTip="Opens drunkdeer.com/pages/downloads — official manuals and firmware updates for all DrunkDeer keyboards."
                        Padding="12,8"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource DdFontSans}"
                        FontSize="11"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DdBorderThin}"
                        BorderThickness="1"
                        Foreground="{DynamicResource DdFg2}"
                        Cursor="Hand"
                        Click="DownloadsButton_Click"/>
                <Button x:Name="OpenLogButton" Grid.Column="2"
                        Content="Open log folder"
                        ToolTip="Opens File Explorer with debug.log selected — drag it anywhere to share."
                        Padding="12,8"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource DdFontSans}"
                        FontSize="11"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DdBorderThin}"
                        BorderThickness="1"
                        Foreground="{DynamicResource DdFg2}"
                        Cursor="Hand"
                        Click="OpenLogButton_Click"/>
                <Button x:Name="CopyDiagnosticsButton" Grid.Column="3"
                        Content="Copy diagnostics"
                        ToolTip="Copies model, USB IDs, raw firmware version, support tier and the last sync to the clipboard, for bug reports."
                        AutomationProperties.Name="Copy diagnostics to the clipboard"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource DdFontSans}"
                        FontSize="{DynamicResource DdFsSm}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DdBorderThin}"
                        BorderThickness="1"
                        Foreground="{DynamicResource DdFg2}"
                        Cursor="Hand"
                        Click="CopyDiagnosticsButton_Click"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- OEM A75 Ultra only: copy the keyboard's key settings into this profile. -->
                    <Button x:Name="LoadFromKeyboardButton"
                            Visibility="Collapsed"
                            Content="Load from keyboard"
                            ToolTip="Copy the keyboard's current key settings into this profile. Nothing is written to the keyboard."
                            AutomationProperties.Name="Load key settings from the keyboard"
                            Padding="12,8"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource DdFontSans}"
                            FontSize="{DynamicResource DdFsSm}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource DdBorderThin}"
                            BorderThickness="1"
                            Foreground="{DynamicResource DdFg2}"
                            Cursor="Hand"
                            Click="LoadFromKeyboardButton_Click"/>
                    <Button x:Name="SyncButton"
                            Content="Sync to keyboard"
                            ToolTip="Push the current profile to the keyboard."
                            Padding="16,8"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource DdFontSans}"
                            FontSize="12"
                            FontWeight="Medium"
                            Background="{DynamicResource DdAccent}"
                            Foreground="{DynamicResource DdFg1}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SyncButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Phase H tab toggle was removed: remapping now happens
                 directly from the right-side drawer (click the code pill,
                 press a key). The Performance/Remap split was confusing
                 and the canvas re-flow was disorienting. -->
            <StackPanel Grid.Row="1" Margin="0,0,0,0"/>

            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,12,0,16">
                <!-- Firmware-update banner. Hidden by default; shown when
                     FirmwareUpdateChecker reports the connected keyboard's
                     firmware is behind what DrunkDeer publishes. The whole
                     border is a clickable hyperlink opening the downloads
                     page. Dismiss (×) hides for this session only — the
                     24h cache in Settings governs how often we re-check. -->
                <Border x:Name="FirmwareBanner"
                        Visibility="Collapsed"
                        Background="{DynamicResource DdAccentSoft}"
                        BorderBrush="{DynamicResource DdAccent}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource DdRadiusMd}"
                        Padding="12,8"
                        Margin="0,0,0,10"
                        Cursor="Hand"
                        MouseLeftButtonUp="FirmwareBanner_MouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FirmwareBannerText"
                                   Grid.Column="0"
                                   FontFamily="{DynamicResource DdFontSans}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DdFg1}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Text="Firmware update available — click to open downloads page."/>
                        <Button x:Name="FirmwareBannerDismiss"
                                Grid.Column="1"
                                Content="×"
                                Width="22" Height="22"
                                Margin="8,0,0,0"
                                Padding="0"
                                FontSize="14"
                                FontWeight="Bold"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource DdFg2}"
                                Cursor="Hand"
                                ToolTip="Dismiss for this session"
                                Click="FirmwareBannerDismiss_Click"/>
                    </Grid>
                </Border>
                <!-- Model-identification banner. Two states (controlled in
                     code-behind by ShowModelBanner):
                       - Unrecognized: keyboard connected but resolver couldn't
                         match TypeCode or PID. Warning tone, A75 Pro layout
                         used as best-effort fallback.
                       - Beta: model resolved but hardware behavior not yet
                         verified on this side (anything outside A75 Pro /
                         A75 Ultra / G65). Softer info tone.
                     Click opens a pre-filled GitHub issue; × dismisses for
                     this session. -->
                <!-- Firmware-changed banner. Shows once per (PID, firmware)
                     transition: when the connected keyboard's firmware
                     differs from the last-seen value stored in settings,
                     warn the user that RDT/LW pair tables may need
                     recreating (the firmware doesn't always migrate them
                     cleanly across versions — see Known Issues #5). The
                     dismiss × stamps the current firmware as the new
                     last-known so it doesn't fire again until the NEXT
                     version change. -->
                <Border x:Name="FirmwareChangedBanner"
                        Visibility="Collapsed"
                        Background="{DynamicResource DdWarnSoft}"
                        BorderBrush="{DynamicResource DdWarn}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource DdRadiusMd}"
                        Padding="12,8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FirmwareChangedBannerText"
                                   Grid.Column="0"
                                   FontFamily="{DynamicResource DdFontSans}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DdFg1}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="FirmwareChangedBannerDismiss"
                                Grid.Column="1"
                                Content="×"
                                Width="22" Height="22"
                                Margin="8,0,0,0"
                                Padding="0"
                                FontSize="14"
                                FontWeight="Bold"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource DdFg2}"
                                Cursor="Hand"
                                ToolTip="Got it — don't show again until next firmware change"
                                Click="FirmwareChangedBannerDismiss_Click"/>
                    </Grid>
                </Border>
                <Border x:Name="ModelStatusBanner"
                        Visibility="Collapsed"
                        Background="{DynamicResource DdWarnSoft}"
                        BorderBrush="{DynamicResource DdWarn}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource DdRadiusMd}"
                        Padding="12,8"
                        Margin="0,0,0,10"
                        Cursor="Hand"
                        MouseLeftButtonUp="ModelStatusBanner_MouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ModelStatusBannerText"
                                   Grid.Column="0"
                                   FontFamily="{DynamicResource DdFontSans}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DdFg1}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ModelStatusBannerDismiss"
                                Grid.Column="1"
                                Content="×"
                                Width="22" Height="22"
                                Margin="8,0,0,0"
                                Padding="0"
                                FontSize="14"
                                FontWeight="Bold"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource DdFg2}"
                                Cursor="Hand"
                                ToolTip="Dismiss for this session"
                                Click="ModelStatusBannerDismiss_Click"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="StatusText"
                           Text="Demo values seeded — WASD/E/F preconfigured. Click a key to change."
                           FontFamily="{DynamicResource DdFontSans}"
                           FontSize="11"
                           Foreground="{DynamicResource DdFg2}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Phase G: global mode toggles. Wired in code-behind to a
                 ProfileSettings instance; values flow into the common-switch
                 packet on Sync. Hidden in Remap mode. -->
            <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,16">
                <kbview:ModeStrip x:Name="ModeStrip" Margin="0,0,0,8"/>
                <!-- OEM A75 Ultra only: the official site's Settings-page
                     switches, read from and written to the keyboard directly
                     (not part of a profile). Collapsed to one line by default
                     so the keyboard keeps its room. -->
                <Border x:Name="UltraSettingsPanel" Visibility="Collapsed" Margin="0,0,0,8"
                        Background="{DynamicResource DdSurface2}"
                        BorderBrush="{DynamicResource DdBorderThin}" BorderThickness="1"
                        CornerRadius="{DynamicResource DdRadiusMd}" Padding="14,8">
                    <StackPanel>
                        <Button x:Name="UltraSettingsHeader" Click="UltraSettingsHeader_Click"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalContentAlignment="Stretch" MinHeight="32"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource DdFg1}"
                                AutomationProperties.Name="Show or hide keyboard settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Keyboard settings" VerticalAlignment="Center" FontFamily="{DynamicResource DdFontSans}"
                                           FontSize="{DynamicResource DdFsBase}" FontWeight="SemiBold" Foreground="{DynamicResource DdFg1}"/>
                                <TextBlock x:Name="UltraSettingsSummary" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource DdFontSans}" FontSize="{DynamicResource DdFsXs}"
                                           Foreground="{DynamicResource DdFg3}" TextTrimming="CharacterEllipsis"/>
                                <materialDesign:PackIcon x:Name="UltraSettingsChevron" Grid.Column="2" Kind="ChevronDown"
                                                         Width="18" Height="18" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource DdFg3}"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="UltraSettingsBody" Visibility="Collapsed" Margin="0,2,0,4">
                            <TextBlock Text="Saved on the keyboard itself, for every profile. Each change is checked after it's sent."
                                       FontFamily="{DynamicResource DdFontSans}" FontSize="{DynamicResource DdFsXs}"
                                       Foreground="{DynamicResource DdFg3}" TextWrapping="Wrap"/>
                            <UniformGrid Columns="4">
                                <Grid Margin="0,6,16,0" ToolTip="Blocks the Windows key so it can't open the Start menu.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lock Win" VerticalAlignment="Center" FontFamily="{DynamicResource DdFontSans}"
                                               FontSize="{DynamicResource DdFsBase}" Foreground="{DynamicResource DdFg1}"/>
                                    <ToggleButton x:Name="UltraLockWin" Grid.Column="1" Margin="8,0,0,0"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  AutomationProperties.Name="Lock Win"
                                                  Click="UltraSetting_Click" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,6,16,0" ToolTip="Stops Alt+Tab from switching programs.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lock Alt+Tab" VerticalAlignment="Center" FontFamily="{DynamicResource DdFontSans}"
                                               FontSize="{DynamicResource DdFsBase}" Foreground="{DynamicResource DdFg1}"/>
                                    <ToggleButton x:Name="UltraLockAltTab" Grid.Column="1" Margin="8,0,0,0"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  AutomationProperties.Name="Lock Alt+Tab"
                                                  Click="UltraSetting_Click" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,6,16,0" ToolTip="Stops Alt+F4 from closing programs.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lock Alt+F4" VerticalAlignment="Center" FontFamily="{DynamicResource DdFontSans}"
                                               FontSize="{DynamicResource DdFsBase}" Foreground="{DynamicResource DdFg1}"/>
                                    <ToggleButton x:Name="UltraLockAltF4" Grid.Column="1" Margin="8,0,0,0"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  AutomationProperties.Name="Lock Alt+F4"
                                                  Click="UltraSetting_Click" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,6,16,0" ToolTip="Helps switches that sometimes miss or drop out.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Adaptive Stable" VerticalAlignment="Center" FontFamily="{DynamicResource DdFontSans}"
                                               FontSize="{DynamicResource DdFsBase}" Foreground="{DynamicResource DdFg1}"/>
                                    <ToggleButton x:Name="UltraAdaptive" Grid.Column="1" Margin="8,0,0,0"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  AutomationProperties.Name="Adaptive Stable"
                                                  Click="UltraSetting_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </UniformGrid>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,8,16,0" ToolTip="Holds very quick taps a little longer so games don't miss them.">
                                    <TextBlock Text="Tick rate" FontFamily="{DynamicResource DdFontSans}"
                                               FontSize="{DynamicResource DdFsXs}" Foreground="{DynamicResource DdFg3}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="UltraTickRate" MinHeight="32"
                                              Style="{StaticResource DdComboBoxStyle}"
                                              Background="{DynamicResource DdSurface2}" BorderBrush="{DynamicResource DdBorderMed}"
                                              Foreground="{DynamicResource DdFg1}" FontSize="{DynamicResource DdFsSm}"
                                              AutomationProperties.Name="Tick rate"
                                              SelectionChanged="UltraField_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,16,0" ToolTip="Filters accidental double presses. Higher adds a little delay.">
                                    <TextBlock Text="Anti-shake" FontFamily="{DynamicResource DdFontSans}"
                                               FontSize="{DynamicResource DdFsXs}" Foreground="{DynamicResource DdFg3}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="UltraAntiShake" MinHeight="32"
                                              Style="{StaticResource DdComboBoxStyle}"
                                              Background="{DynamicResource DdSurface2}" BorderBrush="{DynamicResource DdBorderMed}"
                                              Foreground="{DynamicResource DdFg1}" FontSize="{DynamicResource DdFsSm}"
                                              AutomationProperties.Name="Anti-shake"
                                              SelectionChanged="UltraField_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,16,0" ToolTip="How often the keyboard reports to the PC. The keyboard reconnects when you change it.">
                                    <TextBlock Text="Polling rate" FontFamily="{DynamicResource DdFontSans}"
                                               FontSize="{DynamicResource DdFsXs}" Foreground="{DynamicResource DdFg3}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="UltraPolling" MinHeight="32"
                                              Style="{StaticResource DdComboBoxStyle}"
                                              Background="{DynamicResource DdSurface2}" BorderBrush="{DynamicResource DdBorderMed}"
                                              Foreground="{DynamicResource DdFg1}" FontSize="{DynamicResource DdFsSm}"
                                              AutomationProperties.Name="Polling rate"
                                              SelectionChanged="UltraField_SelectionChanged"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="UltraSettingsStatus" Text="" FontFamily="{DynamicResource DdFontSans}"
                                       FontSize="{DynamicResource DdFsXs}" Foreground="{DynamicResource DdFg3}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- LW pair editor — visible only when Last Win is on AND
                     we're in Performance (not Remap) mode. Pairs persist
                     in Settings.LastWinPairsJson. -->
                <kbview:LastWinPairsBar x:Name="LwPairsBar" Visibility="Collapsed"/>
                <!-- RDT pair editor — visible only when Release Dual-Trigger
                     is on. Pairs persist in Settings.ReleaseDualTriggerPairsJson.
                     LW + RDT are mutually exclusive at the toggle level so only
                     one of these bars is ever visible at a time. -->
                <kbview:ReleaseDualTriggerPairsBar x:Name="RdtPairsBar" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Phase F: quick-select pills above the canvas. -->
            <kbview:QuickSelectBar x:Name="QuickSelectBar" Grid.Row="4" Margin="0,0,0,12"/>

            <Border Grid.Row="5"
                    x:Name="CanvasBorder"
                    Background="{DynamicResource DdSurface1}"
                    BorderBrush="{DynamicResource DdBorderThin}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource DdRadiusLg}"
                    Padding="16,22"
                    ClipToBounds="True"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                    LostMouseCapture="Canvas_LostMouseCapture">
                <Grid>
                    <!-- Viewbox so the keyboard scales to fit available space.
                         Without this, the StackPanel renders at natural
                         key-cap size and gets clipped by ClipToBounds when
                         the host window is shorter than the keyboard's
                         natural height (e.g. windowed mode at default
                         heights — F-row cropped at top, modifier-row at
                         bottom). StretchDirection=DownOnly: the Viewbox only shrinks.
                         Growing on big windows is done by FitKeyUnit (bigger
                         keys, nearly the same text size); magnifying the whole
                         picture made legends and borders look bloated.
                         MarqueeLayer sits OUTSIDE the Viewbox: marquee rect
                         is drawn in CanvasBorder coords matching the
                         mouse, and cap-rect intersection uses
                         TransformToVisual(CanvasBorder) which already
                         accounts for the Viewbox scale (see
                         KeyboardPerformanceView.xaml.cs ~line 2342). -->
                    <Viewbox x:Name="KeyboardViewbox" Stretch="Uniform" StretchDirection="DownOnly">
                        <StackPanel x:Name="RowsHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                    <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False">
                        <Rectangle x:Name="MarqueeRect"
                                   Width="0" Height="0"
                                   Visibility="Collapsed"
                                   Fill="#269575CD"
                                   Stroke="#809575CD"
                                   StrokeThickness="1"
                                   StrokeDashArray="3,2"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Phase F: bottom preset bar (FPS / Typing / Reset). Hidden in Remap mode. -->
            <kbview:PresetBar x:Name="PresetBar" Grid.Row="6" Margin="0,16,0,0"/>

            <!-- Only shown when the active layout has slots not yet verified on hardware. -->
            <StackPanel x:Name="UncertainLegend" Grid.Row="7" Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#FFFFAB40" VerticalAlignment="Center"/>
                <TextBlock Text="uncertain slot mapping — confirm on hardware"
                           FontFamily="{DynamicResource DdFontSans}"
                           FontSize="11"
                           Foreground="{DynamicResource DdFg3}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Drawer column — the single right-side drawer now handles both
             actuation tuning and remapping (click the code pill to rebind).
             The separate RemapDrawer is gone. The RdtPairDrawer occupies
             the same slot and is shown mutually-exclusively when the user
             is editing an RDT pair. -->
        <Grid x:Name="DrawerColumn" Grid.Column="1">
            <kbview:ActuationDrawer x:Name="Drawer"/>
            <kbview:RdtPairDrawer x:Name="RdtDrawer" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
